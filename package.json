{
  "name": "braga-frame",
  "version": "0.1.0",
  "description": "Analisa gameplays e lives, ajuda a revisar cortes e exporta em vertical com controle de qualidade.",
  "main": "main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=2 \"tests/**/*.test.js\"",
    "test:e2e": "node scripts/run-e2e.js",
    "test:network": "node scripts/run-network-tests.js",
    "test:perf": "node scripts/run-perf-tests.js",
    "test:installer": "node scripts/testar-instalador.js",
    "lint": "eslint . --ignore-pattern \".tmp/**\"",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^43.7.7",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "author": "Mauro Braga Filho",
  "build": {
    "appId": "com.bragadev.bragaframe",
    "productName": "Braga Frame",
    "copyright": "Copyright © Mauro Braga Filho",
    "directories": {
      "output": "dist/installer",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "extraFiles": [
      "THIRD-PARTY-NOTICES.md",
      {
        "from": "LICENSE",
        "to": "LICENSE.bragaframe.txt"
      },
      {
        "from": "renderer/assets/fonts",
        "to": "licenses/fonts",
        "filter": [
          "OFL-*.txt",
          "APACHE-*.txt",
          "FONTES_ORIGEM.md"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "braga-frame-${version}-windows-${arch}-setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Braga Frame"
    },
    "publish": null
  }
}
